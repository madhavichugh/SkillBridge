# ==========================================
# SkillBridge Environment Configuration
# ==========================================

# Google Gemini API Key (get one from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding model to use for semantic skill matching
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Semantic matching thresholds (0.0 to 1.0)
SIMILARITY_THRESHOLD_STRONG=0.75
SIMILARITY_THRESHOLD_PARTIAL=0.50

# Server configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# SQLite database file path
DATABASE_URL=sqlite:///./skillbridge.db
